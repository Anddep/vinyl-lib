# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# --- Runtime mode ---
NODE_ENV=development

# --- Host port mappings ---
CLIENT_PORT=5173
SERVER_PORT=4000
POSTGRES_PORT=5432

# --- Postgres credentials (used by the db service, and to build DATABASE_URL) ---
POSTGRES_USER=vinyl_lib
POSTGRES_PASSWORD=vinyl_lib_dev_password
POSTGRES_DB=vinyl_lib

# --- Server database connection string ---
# Host "db" is the Docker Compose service name, resolved on the app-network.
DATABASE_URL=postgresql://vinyl_lib:vinyl_lib_dev_password@db:5432/vinyl_lib?schema=public

# --- Test database (used by `npm test -w server`) ---
# Same Postgres instance, separate database, so tests never truncate dev data.
# Host-side URL: tests run on the host, not inside the compose network.
DATABASE_URL_TEST=postgresql://vinyl_lib:vinyl_lib_dev_password@localhost:5432/vinyl_lib_test?schema=public

# --- Admin ---
# One admin, one password. Generate the hash with:
#   npm run admin:hash -w server -- 'your password'
# IMPORTANT: Docker Compose interpolates $ in .env values, and a bcrypt hash
# is full of them. Double every $ when pasting: $2b$12$... becomes $$2b$$12$$...
ADMIN_PASSWORD_HASH=
# Signs the session cookie. Use hex — base64 can contain $, which Compose
# would try to interpolate:
#   openssl rand -hex 32
SESSION_SECRET=
