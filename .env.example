# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# --- Runtime mode ---
NODE_ENV=development

# --- Host port mappings ---
CLIENT_PORT=5173
SERVER_PORT=4000
POSTGRES_PORT=5432

# --- Postgres credentials (used by the db service, and to build DATABASE_URL) ---
POSTGRES_USER=vinyl_lib
POSTGRES_PASSWORD=vinyl_lib_dev_password
POSTGRES_DB=vinyl_lib

# --- Server database connection string ---
# Host "db" is the Docker Compose service name, resolved on the app-network.
DATABASE_URL=postgresql://vinyl_lib:vinyl_lib_dev_password@db:5432/vinyl_lib?schema=public

# --- Test database (used by `npm test -w server`) ---
# Same Postgres instance, separate database, so tests never truncate dev data.
# Host-side URL: tests run on the host, not inside the compose network.
DATABASE_URL_TEST=postgresql://vinyl_lib:vinyl_lib_dev_password@localhost:5432/vinyl_lib_test?schema=public

# --- Public origin ---
# The origin the browser sees. Must match the callback URLs registered with
# Google and GitHub byte-for-byte.
#   Dev:  http://localhost:5173
#   Prod: https://your-host
PUBLIC_BASE_URL=http://localhost:5173

# --- Reverse proxies in front of Express ---
# How many hops to trust when resolving the client's address from
# X-Forwarded-For. A count, never `true` — the client writes that header, so
# trusting it unconditionally lets a visitor forge the address they are rate
# limited by.
#   Dev and `npm run prod`:  1  (nginx, or the Vite dev proxy)
#   Public deployment:       2  (Caddy terminates TLS, then nginx)
# Both failure modes are silent: too few and req.ip becomes a container's
# bridge address, so every per-IP limit becomes one shared bucket and the
# Secure session cookie is never sent, which breaks sign-in with no error.
TRUST_PROXY_HOPS=1

# --- OAuth providers (at least one pair is required) ---
# Register the callback as <PUBLIC_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register the callback as <PUBLIC_BASE_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs the session cookie. Use hex — base64 can contain $, which Compose
# would try to interpolate:
#   openssl rand -hex 32
SESSION_SECRET=

# --- Bootstrap owner ---
# The first sign-in with this verified email claims the collection that already
# exists in the database, instead of creating a second account. Set it before
# signing in for the first time.
BOOTSTRAP_OWNER_EMAIL=

# --- Signup gate ---
# closed  only existing users can sign in
# invite  a new account needs an invite code (issue one with psql, see README)
# open    anyone with a verified Google or GitHub email
SIGNUP_MODE=invite

# --- Per-account ceilings. Defaults shown; override only if you need to. ---
# 5 MB per file, 150 MB per account.
MAX_UPLOAD_BYTES=5242880
UPLOAD_QUOTA_BYTES=157286400
MAX_RECORDS_PER_USER=5000
MAX_WISHLIST_PER_USER=500
MAX_SETUP_PER_USER=100
# Site-wide, not per IP. See the README on why.
MAX_SIGNUPS_PER_HOUR=20
