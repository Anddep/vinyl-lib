# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# --- Runtime mode ---
NODE_ENV=development

# --- Host port mappings ---
CLIENT_PORT=5173
SERVER_PORT=4000
POSTGRES_PORT=5432

# --- Postgres credentials (used by the db service, and to build DATABASE_URL) ---
POSTGRES_USER=vinyl_lib
POSTGRES_PASSWORD=vinyl_lib_dev_password
POSTGRES_DB=vinyl_lib

# --- Server database connection string ---
# Host "db" is the Docker Compose service name, resolved on the app-network.
DATABASE_URL=postgresql://vinyl_lib:vinyl_lib_dev_password@db:5432/vinyl_lib?schema=public
