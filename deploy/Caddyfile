# The public edge. Caddy terminates TLS, redirects HTTP to HTTPS, sets the
# security headers, and proxies everything else to the client nginx — which
# keeps its own routing, so /api/* and /uploads/* still travel with the image
# rather than becoming host configuration.
#
# The site address is the only thing that changes when the domain does. Set it
# to `localhost` and Caddy issues from its internal CA, which makes this whole
# edge — TLS, headers, CSP, proxy chain — testable without a VM.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Derived from what the built client actually loads, not from what it seems
	# like it ought to. `npm run build -w client` emits no inline <script> and no
	# inline <style> — Vite extracts CSS to a file and lazy routes add
	# <link rel=stylesheet> at runtime — so the only inline styling is the style
	# attribute on VinylDisc and ImagePlaceholder, both passing a custom
	# property. style-src-attr grants exactly those two while <style> injection
	# stays refused, which is why style-src itself does not carry
	# 'unsafe-inline'.
	#
	# img-src is deliberately wide and is not new: coverUrl accepts any external
	# image, which is the existing design. The accepted cost is that a collection
	# owner can point a cover at a server they control and log the IP of everyone
	# who views their page. Proxying every external image would close that and
	# open an SSRF surface instead.
	#
	# `upgrade-insecure-requests` is deliberately absent. It rewrites every
	# http:// subresource to https://, which breaks the site outright whenever it
	# is served over plain HTTP — as it is before a certificate exists — because
	# the browser upgrades /assets/*.js to a port nothing is listening on and the
	# page renders blank with no network error visible in the response.
	#
	# It also buys very little here. Every subresource is either a same-origin
	# relative URL, which inherits the document's scheme automatically, or one of
	# the two Google Font hosts, which are already https. A user-supplied http://
	# coverUrl is refused by img-src rather than upgraded, which is the safer of
	# the two behaviours. HSTS handles the top-level upgrade for real visitors.
	#
	# Note this class of bug is invisible to curl, which does not enforce CSP at
	# all. Policy changes need a browser.
	#
	# Scoped away from /api/*, where helmet already sets a policy. Two policies
	# are enforced as their intersection, which buys nothing and costs one
	# confusing debugging session later.
	@document not path /api/*
	header @document Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

	header {
		# A year, subdomains included. No `preload`: submitting to the preload
		# list is close to a one-way door — removal is a request to browser
		# vendors that takes months to propagate — and a year of HSTS is the
		# same protection for every visitor past their first request.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# An uploaded file is never re-interpreted by content sniffing.
		X-Content-Type-Options "nosniff"

		# Belt to the CSP's frame-ancestors braces, for anything old enough to
		# need it.
		X-Frame-Options "DENY"

		# Record cards link out to Discogs, Bandcamp, anywhere. The path of the
		# page someone left should not travel with them.
		Referrer-Policy "strict-origin-when-cross-origin"

		# The site uses none of these and should not be able to start.
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"

		# The version of the proxy is not the visitor's business.
		-Server
	}

	# Cache aggressively. The free tier this runs on allows 1 GB of egress a
	# month, and cover images are most of the weight — so a repeat visitor
	# re-downloading the bundle is a real cost, not a rounding error.
	#
	# Vite emits content-hashed filenames under /assets, so those can be
	# immutable: a changed file gets a new name and the old URL is never reused.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Uploaded covers are named with a UUID and never rewritten in place, so the
	# same reasoning applies. A month rather than a year, because a deleted
	# upload should stop being served in a bounded time.
	@uploads path /uploads/*
	header @uploads Cache-Control "public, max-age=2592000"

	# The HTML document itself must not be cached, or a deploy would not be
	# visible until the cache expired.
	@document_html path /
	header @document_html Cache-Control "no-cache"

	reverse_proxy client:80
}
